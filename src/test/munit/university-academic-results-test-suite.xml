				<munit:attributes value='#[{ uriParams: { studentId: "101" } }]' />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\students\(studentId)\grade:application\json:university-academic-results-api-config" doc:id="5d44124b-d471-4028-a07f-8bdfeb2f9c32" name="post:\students\(studentId)\grade:application\json:university-academic-results-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="5e68c80e-8b1c-424c-a620-35783f9694a4" expression="#[payload.message]" is='#[MunitTools::equalTo("Grade updated successfully")]'/>
		</munit:validation>
